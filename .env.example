# Copy to .env and fill in. The schema lives in src/env.js; keep this file in sync.

# Prisma / Postgres
DATABASE_URL="postgresql://postgres:password@localhost:5432/pantry"

# NextAuth. Generate a secret with: npx auth secret
AUTH_SECRET=""

# Google sign-in (https://console.cloud.google.com/apis/credentials).
# Authorized redirect URI: <your origin>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Comma-separated emails of household members. Everyone else is refused at sign-in.
HOUSEHOLD_EMAILS="you@example.com,partner@example.com"

# Local development only: sign in with any household email, no password. Ignored in production.
AUTH_DEV_LOGIN="false"

# Claude vision for identifying items in scan photos.
ANTHROPIC_API_KEY=""
# VISION_MODEL="claude-opus-5"

# Vercel Blob (private) for scan photos. Without it, photos are saved to ./.data/uploads.
BLOB_READ_WRITE_TOKEN=""

# Web Push. Generate a key pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Postal code for weekly-ad deal search (Flipp store adapter).
HOUSEHOLD_POSTAL_CODE=""
